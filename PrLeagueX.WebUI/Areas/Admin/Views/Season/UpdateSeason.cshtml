@model PrLeagueX.DtoLayer.SeasonDtos.UpdateSeasonDto

@{
    Layout = "~/Areas/Admin/Views/Admin/Index.cshtml";
}

<div class="panel active">
    <div class="panel-head">
        <div class="ph-ico blue">
            <i class="bi bi-pencil-square"></i>
        </div>

        <div>
            <div class="ph-title">Sezon Güncelle</div>
            <div class="ph-sub">Sezon bilgilerini düzenleyin.</div>
        </div>

        <div class="ph-right">
            <a href="/Admin/Season/Index" class="btn btn-ghost">
                <i class="bi bi-arrow-left"></i> Listeye Dön
            </a>
        </div>
    </div>

    <div class="panel-body">

        <form asp-area="Admin" asp-controller="Season" asp-action="UpdateSeason" method="post">
            @Html.AntiForgeryToken()

            <!-- ID -->
            <input type="hidden" asp-for="SeasonId" />

            <div style="width:100%;display:grid;grid-template-columns:2fr 1fr;gap:22px">

                <!-- SOL -->
                <div style="background:var(--bg2);border:1px solid var(--border);border-radius:var(--r2);padding:20px">

                    <div style="display:flex;align-items:center;gap:12px;margin-bottom:20px">
                        <div style="width:38px;height:38px;border-radius:10px;background:rgba(41,121,255,.12);color:var(--blue);display:flex;align-items:center;justify-content:center">
                            <i class="bi bi-calendar"></i>
                        </div>

                        <div>
                            <div style="font-family:var(--fd);font-size:17px;font-weight:800">
                                Sezon Bilgileri
                            </div>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">Sezon Adı</label>
                            <input asp-for="SeasonName" class="form-control" />
                        </div>

                        <div class="form-group">
                            <label class="form-label">Lig</label>
                            <select asp-for="LeagueId" asp-items="ViewBag.Leagues" class="form-control form-select">
                                <option value="">Lig Seçiniz</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">Başlangıç Tarihi</label>
                            <input asp-for="StartDate" type="date" class="form-control" />
                        </div>

                        <div class="form-group">
                            <label class="form-label">Bitiş Tarihi</label>
                            <input asp-for="EndDate" type="date" class="form-control" />
                        </div>
                    </div>

                </div>

                <!-- SAĞ -->
                <div style="background:var(--bg2);border:1px solid var(--border);border-radius:var(--r2);padding:20px">

                    <div class="form-group">
                        <label class="form-label">Durum</label>

                        <select asp-for="IsActive" class="form-control form-select">
                            <option value="true">Aktif</option>
                            <option value="false">Pasif</option>
                        </select>
                    </div>

                    <hr class="dvdr" />

                    <div style="display:flex;flex-direction:column;gap:10px">

                        <button type="submit" class="btn btn-blue" style="width:100%">
                            <i class="bi bi-check-lg"></i> Güncelle
                        </button>

                        <a href="/Admin/Season/Index" class="btn btn-ghost" style="width:100%;justify-content:center">
                            Vazgeç
                        </a>

                    </div>

                </div>

            </div>

        </form>

    </div>
</div>