@model PrLeagueX.DtoLayer.SeasonDtos.CreateSeasonDto

@{
    Layout = "~/Areas/Admin/Views/Admin/Index.cshtml";
}

<div class="panel active">
    <div class="panel-head">
        <div class="ph-ico gold">
            <i class="bi bi-calendar-plus"></i>
        </div>

        <div>
            <div class="ph-title">Yeni Sezon Ekle</div>
            <div class="ph-sub">Lig için yeni sezon bilgilerini oluşturun.</div>
        </div>

        <div class="ph-right">
            <a href="/Admin/Season/Index" class="btn btn-ghost">
                <i class="bi bi-arrow-left"></i> Listeye Dön
            </a>
        </div>
    </div>

    <div class="panel-body">

        <form asp-area="Admin" asp-controller="Season" asp-action="CreateSeason" method="post">
            @Html.AntiForgeryToken()

            <div style="width:100%;display:grid;grid-template-columns:2fr 1fr;gap:22px;align-items:start">

                <!-- SOL BLOK -->
                <div style="background:var(--bg2);border:1px solid var(--border);border-radius:var(--r2);padding:20px">

                    <div style="display:flex;align-items:center;gap:12px;margin-bottom:20px">
                        <div style="width:38px;height:38px;border-radius:10px;background:rgba(255,214,0,.12);color:var(--gold);display:flex;align-items:center;justify-content:center">
                            <i class="bi bi-trophy"></i>
                        </div>

                        <div>
                            <div style="font-family:var(--fd);font-size:17px;font-weight:800;color:var(--t1)">
                                Sezon Bilgileri
                            </div>
                            <div style="font-size:12px;color:var(--t3)">
                                Sezon adı, lig ve tarih aralığını girin.
                            </div>
                        </div>
                    </div>

                    <!-- SEZON + LİG -->
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">Sezon Adı</label>
                            <input asp-for="SeasonName" class="form-control" placeholder="ör. 2026/2027" />
                            <span asp-validation-for="SeasonName" style="color:var(--live);font-size:12px"></span>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Lig</label>
                            <select asp-for="LeagueId" asp-items="ViewBag.Leagues" class="form-control form-select">
                                <option value="">Lig Seçiniz</option>
                            </select>
                            <span asp-validation-for="LeagueId" style="color:var(--live);font-size:12px"></span>
                        </div>
                    </div>

                    <!-- TARİHLER -->
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">Başlangıç Tarihi</label>
                            <input asp-for="StartDate" type="date" class="form-control" />
                            <span asp-validation-for="StartDate" style="color:var(--live);font-size:12px"></span>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Bitiş Tarihi</label>
                            <input asp-for="EndDate" type="date" class="form-control" />
                            <span asp-validation-for="EndDate" style="color:var(--live);font-size:12px"></span>
                        </div>
                    </div>

                </div>

                <!-- SAĞ BLOK -->
                <div style="background:var(--bg2);border:1px solid var(--border);border-radius:var(--r2);padding:20px">

                    <div style="font-family:var(--fd);font-size:14px;font-weight:800;color:var(--t1);margin-bottom:14px">
                        Durum
                    </div>

                    <div class="form-group">
                        <select asp-for="IsActive" class="form-control form-select">
                            <option value="true" selected>Aktif</option>
                            <option value="false">Pasif</option>
                        </select>
                        <span asp-validation-for="IsActive" style="color:var(--live);font-size:12px"></span>
                    </div>

                    <hr class="dvdr" />

                    <div style="display:flex;flex-direction:column;gap:10px">

                        <button type="submit" class="btn btn-gold" style="width:100%">
                            <i class="bi bi-check-lg"></i> Sezonu Kaydet
                        </button>

                        <a href="/Admin/Season/Index" class="btn btn-ghost" style="width:100%;justify-content:center">
                            <i class="bi bi-x-lg"></i> Vazgeç
                        </a>

                    </div>

                </div>

            </div>

        </form>

    </div>
</div>