@model PrLeagueX.DtoLayer.TeamDtos.CreateTeamDto

@{
    Layout = "~/Areas/Admin/Views/Admin/Index.cshtml";
}

<div class="panel active">
    <div class="panel-head">
        <div class="ph-ico gold">
            <i class="bi bi-shield-plus"></i>
        </div>

        <div>
            <div class="ph-title">Yeni Takım Ekle</div>
            <div class="ph-sub">Lig sisteminde kullanılacak takım bilgilerini girin.</div>
        </div>

        <div class="ph-right">
            <a href="/Admin/Team/Index" class="btn btn-ghost">
                <i class="bi bi-arrow-left"></i> Listeye Dön
            </a>
        </div>
    </div>

    <div class="panel-body">
        <form asp-area="Admin" asp-controller="Team" asp-action="CreateTeam" method="post">
            @Html.AntiForgeryToken()

            <div style="display:grid;grid-template-columns:110px 1fr;gap:22px;align-items:start;margin-bottom:22px">
                <div style="background:var(--bg2);border:1px solid var(--border);border-radius:var(--r2);padding:16px;text-align:center">
                    <div style="width:70px;height:70px;margin:0 auto 10px;border-radius:50%;background:var(--elevated);border:1px solid rgba(255,214,0,.25);display:flex;align-items:center;justify-content:center;color:var(--gold);font-size:28px">
                        <i class="bi bi-image"></i>
                    </div>
                    <div style="font-family:var(--fd);font-size:11px;color:var(--t3);font-weight:700;letter-spacing:1px">
                        TAKIM LOGOSU
                    </div>
                </div>

                <div>
                    <div class="form-group">
                        <label class="form-label">Logo URL</label>
                        <input asp-for="LogoUrl" class="form-control" placeholder="https://example.com/logo.png" />
                        <span asp-validation-for="LogoUrl" style="color:var(--live);font-size:12px"></span>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">Takım Adı *</label>
                            <input asp-for="TeamName" class="form-control" placeholder="ör. Manchester City" />
                            <span asp-validation-for="TeamName" style="color:var(--live);font-size:12px"></span>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Kısa Ad *</label>
                            <input asp-for="ShortName" class="form-control" placeholder="ör. MCI" maxlength="3" />
                            <span asp-validation-for="ShortName" style="color:var(--live);font-size:12px"></span>
                        </div>
                    </div>
                </div>
            </div>

            <hr class="dvdr" />

            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">Şehir</label>
                    <input asp-for="City" class="form-control" placeholder="ör. Manchester" />
                    <span asp-validation-for="City" style="color:var(--live);font-size:12px"></span>
                </div>

                <div class="form-group">
                    <label class="form-label">Stadyum Adı</label>
                    <input asp-for="StadiumName" class="form-control" placeholder="ör. Etihad Stadium" />
                    <span asp-validation-for="StadiumName" style="color:var(--live);font-size:12px"></span>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">Kuruluş Yılı</label>
                    <input asp-for="FoundedYear" type="number" class="form-control" placeholder="ör. 1880" />
                    <span asp-validation-for="FoundedYear" style="color:var(--live);font-size:12px"></span>
                </div>

                <div class="form-group">
                    <label class="form-label">Stadyum ID</label>
                    <input asp-for="StadiumId" type="number" class="form-control" placeholder="Opsiyonel" />
                    <span asp-validation-for="StadiumId" style="color:var(--live);font-size:12px"></span>
                </div>
            </div>

            <div style="background:var(--bg2);border:1px solid var(--border);border-radius:var(--r2);padding:14px 16px;margin-bottom:22px;display:flex;align-items:center;justify-content:space-between;gap:16px">
                <div>
                    <div style="font-family:var(--fd);font-size:14px;font-weight:800;color:var(--t1);letter-spacing:.5px">
                        Takım Aktif Olsun
                    </div>
                    <div style="font-size:12px;color:var(--t3);margin-top:3px">
                        Pasif yapılırsa takım listelerde kullanılmayabilir.
                    </div>
                </div>

                <div>
                    <input asp-for="IsActive" type="checkbox" checked />
                </div>
            </div>

            <div style="display:flex;gap:10px;justify-content:flex-end;flex-wrap:wrap">
                <a href="/Admin/Team/Index" class="btn btn-ghost">
                    <i class="bi bi-x-lg"></i> Vazgeç
                </a>

                <button type="submit" class="btn btn-gold">
                    <i class="bi bi-check-lg"></i> Takımı Kaydet
                </button>
            </div>
        </form>
    </div>
</div>