@model PrLeagueX.DtoLayer.MatchDetailDtos.CreateMatchDetailDto

@{
    Layout = "~/Areas/Admin/Views/Admin/Index.cshtml";
}

<div class="panel active">
    <div class="panel-head">
        <div class="ph-ico green">
            <i class="bi bi-dribbble"></i>
        </div>

        <div>
            <div class="ph-title">Gol Ekle</div>
            <div class="ph-sub">Golün hangi takıma ait olduğunu seçerek maç olayına ekleyin.</div>
        </div>

        <div class="ph-right">
            <a href="/Admin/MatchEvent/Manage/@Model.MatchId" class="btn btn-ghost">
                <i class="bi bi-arrow-left"></i> Olaylara Dön
            </a>
        </div>
    </div>

    <div class="panel-body">
        <form asp-area="Admin" asp-controller="MatchDetail" asp-action="CreateGoal" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="MatchId" />

            <div style="width:100%;background:var(--bg2);border:1px solid var(--border);border-radius:var(--r2);padding:22px">

                <div style="display:grid;grid-template-columns:1fr 220px;gap:16px">
                    <div class="form-group">
                        <label class="form-label">Takım *</label>
                        <select asp-for="TeamId" asp-items="ViewBag.Teams" class="form-control form-select">
                            <option value="">Takım Seçiniz</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Dakika *</label>
                        <input asp-for="Minute" type="number" min="1" max="120" class="form-control" placeholder="ör. 38" />
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Gol Açıklaması *</label>
                    <input asp-for="Description" class="form-control" placeholder="ör. Bowen gol attı / Asist: Paqueta" />
                </div>

                <div style="display:flex;justify-content:flex-end;gap:10px;margin-top:10px">
                    <a href="/Admin/MatchEvent/Manage/@Model.MatchId" class="btn btn-ghost">
                        <i class="bi bi-x-lg"></i> Vazgeç
                    </a>

                    <button type="submit" class="btn btn-green">
                        <i class="bi bi-check-lg"></i> Golü Kaydet
                    </button>
                </div>

            </div>
        </form>
    </div>
</div>