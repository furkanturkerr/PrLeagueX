@{
    Layout = "~/Areas/Admin/Views/Admin/Index.cshtml";
    int matchId = ViewBag.MatchId;
}

<div class="panel active">
    <div class="panel-head">
        <div class="ph-ico green">
            <i class="bi bi-activity"></i>
        </div>

        <div>
            <div class="ph-title">Maç Olayları Yönetimi</div>
            <div class="ph-sub">Bu maça ait gol, kart, değişiklik ve istatistik işlemlerini yönetin.</div>
        </div>

        <div class="ph-right">
            <a href="/Admin/Match/UpdateMatch/@matchId" class="btn btn-ghost">
                <i class="bi bi-arrow-left"></i> Maça Dön
            </a>
        </div>
    </div>

    <div class="panel-body">
        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:16px">

            <a href="/Admin/MatchDetail/CreateGoal/@matchId"
               style="background:var(--bg2);border:1px solid rgba(0,230,118,.25);border-radius:var(--r2);padding:22px;text-align:center">
                <div style="width:48px;height:48px;margin:0 auto 14px;border-radius:12px;background:rgba(0,230,118,.12);color:var(--green);display:flex;align-items:center;justify-content:center;font-size:22px">
                    <i class="bi bi-dribbble"></i>
                </div>
                <div style="font-family:var(--fd);font-size:16px;font-weight:800;color:var(--t1)">Gol Ekle</div>
                <div style="font-size:12px;color:var(--t3);margin-top:6px">Gol atan oyuncu, dakika ve açıklama gir.</div>
            </a>

            <a href="/Admin/MatchDetail/CreateCard/@matchId"
               style="background:var(--bg2);border:1px solid rgba(255,214,0,.25);border-radius:var(--r2);padding:22px;text-align:center">
                <div style="width:48px;height:48px;margin:0 auto 14px;border-radius:12px;background:rgba(255,214,0,.12);color:var(--gold);display:flex;align-items:center;justify-content:center;font-size:22px">
                    <i class="bi bi-file-earmark-fill"></i>
                </div>
                <div style="font-family:var(--fd);font-size:16px;font-weight:800;color:var(--t1)">Kart Ekle</div>
                <div style="font-size:12px;color:var(--t3);margin-top:6px">Sarı veya kırmızı kart olayını gir.</div>
            </a>

            <a href="/Admin/MatchDetail/CreateSubstitution/@matchId"
               style="background:var(--bg2);border:1px solid rgba(41,121,255,.25);border-radius:var(--r2);padding:22px;text-align:center">
                <div style="width:48px;height:48px;margin:0 auto 14px;border-radius:12px;background:rgba(41,121,255,.12);color:var(--blue);display:flex;align-items:center;justify-content:center;font-size:22px">
                    <i class="bi bi-arrow-left-right"></i>
                </div>
                <div style="font-family:var(--fd);font-size:16px;font-weight:800;color:var(--t1)">Oyuncu Değişikliği</div>
                <div style="font-size:12px;color:var(--t3);margin-top:6px">Giren ve çıkan oyuncu bilgisini ekle.</div>
            </a>

            <a href="/Admin/MatchStatistic/CreateOrUpdate/@matchId"
               style="background:var(--bg2);border:1px solid rgba(120,80,255,.25);border-radius:var(--r2);padding:22px;text-align:center">
                <div style="width:48px;height:48px;margin:0 auto 14px;border-radius:12px;background:rgba(120,80,255,.12);color:#a78bfa;display:flex;align-items:center;justify-content:center;font-size:22px">
                    <i class="bi bi-bar-chart-fill"></i>
                </div>
                <div style="font-family:var(--fd);font-size:16px;font-weight:800;color:var(--t1)">İstatistik Ekle</div>
                <div style="font-size:12px;color:var(--t3);margin-top:6px">Şut, korner, faul ve kart sayılarını gir.</div>
            </a>

        </div>
    </div>
</div>