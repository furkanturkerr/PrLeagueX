<style>
    .nb {
        background: rgba(8,13,24,.96);
        backdrop-filter: blur(20px);
        border-bottom: 1px solid var(--border);
        position: sticky;
        top: 0;
        z-index: 1000;
        box-shadow: 0 2px 24px rgba(0,0,0,.5);
    }

    .nb-inner {
        max-width: 1120px;
        margin: 0 auto;
        padding: 0 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
    }

    .brand {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 14px 0;
        text-decoration: none;
        color: var(--t1);
    }

    .brand-ico {
        width: 34px;
        height: 34px;
        background: linear-gradient(135deg, var(--green), var(--blue));
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 17px;
        box-shadow: 0 0 20px rgba(0,230,118,.18);
    }

    .brand-txt {
        font-family: var(--fd);
        font-size: 22px;
        font-weight: 900;
        letter-spacing: 1px;
    }

    .brand-txt span {
        color: var(--green);
    }

    .nav-links {
        display: flex;
        align-items: center;
    }

    .nl {
        font-family: var(--fd);
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 1.4px;
        text-transform: uppercase;
        color: var(--t2);
        padding: 22px 15px;
        position: relative;
        transition: var(--tr);
        text-decoration: none;
    }

    .nl::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 15px;
        right: 15px;
        height: 2px;
        background: var(--green);
        transform: scaleX(0);
        transform-origin: center;
        transition: var(--tr);
    }

    .nl:hover,
    .nl.active {
        color: var(--t1);
    }

    .nl:hover::after,
    .nl.active::after {
        transform: scaleX(1);
    }

    .nb-icons {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .ico-btn {
        width: 36px;
        height: 36px;
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: var(--r1);
        color: var(--t2);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        transition: var(--tr);
        text-decoration: none;
    }

    .ico-btn:hover {
        background: var(--card2);
        color: var(--green);
        border-color: rgba(0,230,118,.35);
    }

    .tog {
        width: 36px;
        height: 36px;
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: var(--r1);
        color: var(--t1);
        cursor: pointer;
        line-height: 1;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .mob-menu {
        max-height: 0;
        overflow: hidden;
        transition: max-height .28s ease;
        border-top: 1px solid transparent;
    }

    .mob-menu.open {
        max-height: 340px;
        border-top-color: var(--border);
    }

    .mob-menu .nl {
        padding: 14px 0;
        border-bottom: 1px solid var(--border);
        display: block;
    }

    .mob-menu .nl::after {
        display: none;
    }
</style>

<nav class="nb">
    <div class="nb-inner">
        <a href="/Default/Index" class="brand">
            <div class="brand-ico">⚽</div>
            <span class="brand-txt">PrLeague<span>X</span></span>
        </a>

        <div class="nav-links d-none d-lg-flex">
            <a href="/Default/Index" class="nl">Ana Sayfa</a>
            <a href="/Match/Index" class="nl">Maçlar</a>
            <a href="/Fixture/Index" class="nl">Fikstür</a>
            <a href="/Standing/Index" class="nl active">Puan Durumu</a>
            <a href="/Team/Index" class="nl">Takımlar</a>
        </div>

        <div class="nb-icons">
            <a href="/Team/Index" class="ico-btn d-none d-sm-flex">
                <i class="bi bi-shield"></i>
            </a>

            <a href="/Fixture/Index" class="ico-btn d-none d-sm-flex">
                <i class="bi bi-calendar-event"></i>
            </a>

            <a href="/Admin/Dashboard/Index" class="ico-btn">
                <i class="bi bi-person"></i>
            </a>

            <button class="tog d-lg-none" id="tog" type="button">
                <i class="bi bi-list"></i>
            </button>
        </div>
    </div>

    <div class="mob-menu" id="mobMenu">
        <div class="wrap">
            <a href="/Default/Index" class="nl d-block">Ana Sayfa</a>
            <a href="/Match/Index" class="nl d-block">Maçlar</a>
            <a href="/Fixture/Index" class="nl d-block">Fikstür</a>
            <a href="/Standing/Index" class="nl d-block active">Puan Durumu</a>
            <a href="/Team/Index" class="nl d-block">Takımlar</a>
        </div>
    </div>
</nav>

<script>
    const tog = document.getElementById('tog');
    const mob = document.getElementById('mobMenu');

    if (tog && mob) {
        tog.addEventListener('click', () => {
            mob.classList.toggle('open');

            tog.innerHTML = mob.classList.contains('open')
                ? '<i class="bi bi-x-lg"></i>'
                : '<i class="bi bi-list"></i>';
        });
    }
</script>