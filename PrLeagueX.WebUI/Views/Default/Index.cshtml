@model PrLeagueX.WebUI.Models.DefaultMatchPageViewModel

@{
    Layout = null;

    var liveMatches = Model.Matches.Where(x => x.Status == 1).ToList();
    var finishedMatches = Model.Matches.Where(x => x.Status == 2).ToList();
    var upcomingMatches = Model.Matches.Where(x => x.Status == 0).ToList();

    var featured = Model.FeaturedMatch ?? Model.Matches.FirstOrDefault();
}

<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>PrLeagueX — Premier League</title>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"/>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;500;600;700;800;900&family=Barlow:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
<link rel="stylesheet" href="~/css/default-navbar.css"/>
<style>
:root{
  --bg:#080d18;--bg2:#0c1220;--card:#111827;--card2:#16202f;--elevated:#1c2d42;
  --green:#00e676;--blue:#2979ff;--live:#ff1744;--gold:#ffd600;--yellow:#ffc107;--red:#f44336;
  --t1:#eef2ff;--t2:#7b96c4;--t3:#3d5478;--border:#1a2640;
  --r1:8px;--r2:12px;--r3:16px;
  --tr:all .22s cubic-bezier(.4,0,.2,1);
  --fd:'Barlow Condensed',sans-serif;--fb:'Barlow',sans-serif;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{
  font-family:var(--fb);
  background:var(--bg);
  color:var(--t1);
  min-height:100vh;
  background-image:
    radial-gradient(ellipse at 15% 0%,rgba(41,121,255,.07) 0%,transparent 55%),
    radial-gradient(ellipse at 85% 0%,rgba(0,230,118,.04) 0%,transparent 50%);
}
::-webkit-scrollbar{width:5px}
::-webkit-scrollbar-track{background:var(--bg)}
::-webkit-scrollbar-thumb{background:var(--elevated);border-radius:3px}
a{text-decoration:none;color:inherit}
img{display:block}
.wrap{max-width:1120px;margin:0 auto;padding:0 20px}

.lg-head{
  background:linear-gradient(135deg,var(--bg2),var(--card));
  border-bottom:1px solid var(--border);
  padding:32px 0 24px;
  position:relative;
  overflow:hidden;
}
.lg-head::before{
  content:'';
  position:absolute;
  top:-40%;
  right:-5%;
  width:380px;
  height:380px;
  background:radial-gradient(circle,rgba(0,230,118,.05) 0%,transparent 70%);
  pointer-events:none;
}
.lg-badge{
  display:inline-flex;
  align-items:center;
  gap:7px;
  background:rgba(255,214,0,.09);
  border:1px solid rgba(255,214,0,.22);
  border-radius:20px;
  padding:4px 12px;
  font-family:var(--fd);
  font-size:11px;
  font-weight:700;
  letter-spacing:1px;
  color:var(--gold);
  text-transform:uppercase;
  margin-bottom:10px;
}
.lg-title{
  font-family:var(--fd);
  font-size:clamp(26px,5vw,42px);
  font-weight:900;
  letter-spacing:.5px;
  line-height:1;
}
.lg-sub{font-size:13px;color:var(--t2);margin-top:6px}
.lg-stats{display:flex;gap:24px;align-items:flex-end;justify-content:flex-end;height:100%}
.ls-num{font-family:var(--fd);font-size:30px;font-weight:800;color:var(--green);line-height:1}
.ls-lbl{font-size:10px;color:var(--t3);text-transform:uppercase;letter-spacing:1px;margin-top:3px}

.ftabs-wrap{
  background:var(--bg2);
  border-bottom:1px solid var(--border);
  position:sticky;
  top:62px;
  z-index:99;
}
.ftabs{display:flex;overflow-x:auto;scrollbar-width:none}
.ftabs::-webkit-scrollbar{display:none}
.ftab{
  font-family:var(--fd);
  font-size:12px;
  font-weight:700;
  letter-spacing:1.2px;
  text-transform:uppercase;
  color:var(--t3);
  padding:15px 18px;
  cursor:pointer;
  border:none;
  background:transparent;
  border-bottom:2px solid transparent;
  transition:var(--tr);
  white-space:nowrap;
}
.ftab:hover{color:var(--t2);background:rgba(255,255,255,.02)}
.ftab.active{color:var(--green);border-bottom-color:var(--green)}
.live-dot{
  display:inline-block;
  width:6px;
  height:6px;
  background:var(--live);
  border-radius:50%;
  margin-right:5px;
  animation:pdot 1.4s ease-in-out infinite;
}
@@keyframes pdot{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.4;transform:scale(.7)}}
.bcnt{background:var(--live);color:#fff;border-radius:9px;font-size:10px;padding:1px 6px;margin-left:5px;font-weight:700}

.feat-wrap{padding:30px 0 6px}
.feat-lbl{
  font-family:var(--fd);
  font-size:11px;
  font-weight:700;
  letter-spacing:2px;
  text-transform:uppercase;
  color:var(--green);
  margin-bottom:12px;
  display:flex;
  align-items:center;
  gap:8px;
}
.feat-lbl::before{content:'';display:inline-block;width:18px;height:2px;background:var(--green)}
.feat-card{
  background:linear-gradient(135deg,#0d1d38 0%,#13213e 50%,#0d1f30 100%);
  border:1px solid rgba(41,121,255,.2);
  border-radius:var(--r3);
  padding:30px 36px;
  position:relative;
  overflow:hidden;
  transition:var(--tr);
  display:block;
  color:inherit;
}
.feat-card:hover{
  border-color:rgba(41,121,255,.5);
  transform:translateY(-2px);
  box-shadow:0 12px 44px rgba(0,0,0,.6);
  color:inherit;
}
.feat-card::after{
  content:'★ ÖNE ÇIKAN MAÇ';
  position:absolute;
  top:14px;
  right:18px;
  font-family:var(--fd);
  font-size:9px;
  font-weight:800;
  letter-spacing:2px;
  color:var(--gold);
  background:rgba(255,214,0,.09);
  border:1px solid rgba(255,214,0,.2);
  padding:3px 10px;
  border-radius:10px;
}
.ft-team{display:flex;flex-direction:column;align-items:center;gap:12px}
.ft-logo{
  width:70px;
  height:70px;
  border-radius:50%;
  background:var(--elevated);
  border:2px solid var(--border);
  display:flex;
  align-items:center;
  justify-content:center;
  font-family:var(--fd);
  font-size:20px;
  font-weight:900;
  overflow:hidden;
}
.ft-logo img{width:100%;height:100%;object-fit:contain;padding:6px}
.ft-name{font-family:var(--fd);font-size:18px;font-weight:800;text-align:center}
.ft-type{font-size:10px;color:var(--t3);text-transform:uppercase;letter-spacing:1.5px;font-weight:600}
.ft-sc-area{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px}
.ft-sc{
  font-family:var(--fd);
  font-size:clamp(42px,7vw,66px);
  font-weight:900;
  letter-spacing:-2px;
  line-height:1;
  background:linear-gradient(180deg,#fff 0%,#9ab5e0 100%);
  -webkit-background-clip:text;
  -webkit-text-fill-color:transparent;
  background-clip:text;
}
.ft-stat{font-family:var(--fd);font-size:12px;font-weight:700;letter-spacing:1.5px;color:var(--t3)}
.ft-meta{font-size:12px;color:var(--t2);text-align:center;margin-top:4px}

.sec-ttl{
  font-family:var(--fd);
  font-size:10px;
  font-weight:700;
  letter-spacing:2px;
  text-transform:uppercase;
  color:var(--t3);
  padding:14px 0 8px;
  border-top:1px solid var(--border);
  margin-top:8px;
  margin-bottom:4px;
}

.mc-wrap{margin-bottom:8px}
.mc{
  width:100%;
  display:flex;
  align-items:center;
  background:var(--card);
  border:1px solid var(--border);
  border-radius:var(--r2);
  padding:0 18px;
  min-height:66px;
  overflow:hidden;
  transition:var(--tr);
  color:inherit;
}
.mc:hover{
  background:var(--card2);
  border-color:rgba(41,121,255,.3);
  transform:translateY(-1px);
  box-shadow:0 6px 24px rgba(0,0,0,.4);
  color:inherit;
}
.mc.live{
  border-color:rgba(255,23,68,.22);
  background:linear-gradient(90deg,var(--card),rgba(255,23,68,.03));
}
.mc.live:hover{border-color:rgba(255,23,68,.45)}
.mc.lp{position:relative}
.mc.lp::before{
  content:'';
  position:absolute;
  inset:-1px;
  border-radius:inherit;
  border:1px solid rgba(255,23,68,.35);
  animation:pbrd 2s ease-in-out infinite;
  pointer-events:none;
}
@@keyframes pbrd{0%,100%{opacity:1;transform:scale(1)}50%{opacity:0;transform:scale(1.012)}}

.mc-time{
  flex-shrink:0;
  width:74px;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  gap:5px;
  padding:12px 0;
}
.mc-min{font-family:var(--fd);font-size:15px;font-weight:700;color:var(--t2)}
.mc-min.lc{color:var(--live)}
.mc-min.bc{color:var(--blue)}
.mc-min.yc{color:var(--yellow)}
.sbadge{
  font-family:var(--fd);
  font-size:9px;
  font-weight:700;
  letter-spacing:.8px;
  text-transform:uppercase;
  padding:2px 7px;
  border-radius:9px;
  white-space:nowrap;
}
.sb-fin{background:rgba(143,163,200,.09);color:var(--t3)}
.sb-live{
  background:rgba(255,23,68,.11);
  color:var(--live);
  border:1px solid rgba(255,23,68,.2);
  display:flex;
  align-items:center;
  gap:3px;
}
.sb-up{background:rgba(41,121,255,.1);color:var(--blue)}
.dvv{width:1px;height:44px;background:var(--border);flex-shrink:0;margin:0 16px}
.mc-teams{flex:1;min-width:0;display:flex;flex-direction:column}
.mc-tr{display:flex;align-items:center;gap:10px;padding:5px 0}
.mc-tr:first-child{border-bottom:1px solid rgba(255,255,255,.04)}
.tl-sm{
  width:26px;
  height:26px;
  border-radius:50%;
  background:var(--elevated);
  border:1px solid var(--border);
  display:flex;
  align-items:center;
  justify-content:center;
  font-family:var(--fd);
  font-size:9px;
  font-weight:800;
  color:var(--t2);
  flex-shrink:0;
  overflow:hidden;
}
.tl-sm img{width:100%;height:100%;object-fit:contain;padding:3px}
.tn{
  font-family:var(--fd);
  font-size:16px;
  font-weight:700;
  letter-spacing:.2px;
  flex:1;
  min-width:0;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}
.ts{
  font-family:var(--fd);
  font-size:22px;
  font-weight:900;
  color:var(--t1);
  min-width:26px;
  text-align:right;
  flex-shrink:0;
}
.ts.win{color:var(--green)}
.ts.dim{font-size:15px;color:var(--t3)}
.det-btn{
  flex-shrink:0;
  margin-left:16px;
  display:inline-flex;
  align-items:center;
  gap:5px;
  background:rgba(41,121,255,.08);
  border:1px solid rgba(41,121,255,.2);
  color:var(--blue);
  border-radius:var(--r1);
  padding:6px 13px;
  font-family:var(--fd);
  font-size:10px;
  font-weight:700;
  letter-spacing:1px;
  text-transform:uppercase;
  cursor:pointer;
  transition:var(--tr);
  white-space:nowrap;
}
.det-btn:hover{background:rgba(41,121,255,.18);color:var(--blue)}
.empty-box{
  background:var(--card);
  border:1px solid var(--border);
  border-radius:var(--r3);
  padding:32px;
  color:var(--t2);
  text-align:center;
}
.ft{
  background:var(--bg2);
  border-top:1px solid var(--border);
  padding:28px 0;
  margin-top:36px;
  color:var(--t3);
  font-size:12px;
}
.ft-brand{font-family:var(--fd);font-size:20px;font-weight:800;color:var(--t1)}
.ft-brand span{color:var(--green)}

@@media(max-width:600px){
  .tn{font-size:13px}
  .ts{font-size:18px}
  .mc-time{width:60px}
  .dvv{margin:0 10px}
  .det-btn{padding:5px 8px;font-size:9px}
  .det-btn span{display:none}
  .feat-card{padding:20px 14px}
  .ft-logo{width:52px;height:52px}
  .ft-name{font-size:14px}
  .ft-sc{font-size:40px}
  .lg-stats{display:none}
}
</style>
</head>

<body>

@await Component.InvokeAsync("_DefaultNavbarComponentPartial")

<section class="lg-head">
  <div class="wrap">
    <div class="row align-items-center">
      <div class="col-lg-7">
        <div class="lg-badge">
          <i class="bi bi-trophy-fill"></i>
          Premier League
        </div>

        <h1 class="lg-title">
          Hafta <span style="color:var(--green)">@Model.SelectedWeek</span> Maçları
        </h1>

        <p class="lg-sub">
          PrLeagueX canlı skor ve maç sonuçları · Seçili sezon: @Model.SelectedSeasonId
        </p>
      </div>

      <div class="col-lg-5 d-none d-lg-block">
        <div class="lg-stats">
          <div style="text-align:center">
            <div class="ls-num">@Model.LiveCount</div>
            <div class="ls-lbl">Canlı</div>
          </div>
          <div style="text-align:center">
            <div class="ls-num">@Model.FinishedCount</div>
            <div class="ls-lbl">Biten</div>
          </div>
          <div style="text-align:center">
            <div class="ls-num">@Model.UpcomingCount</div>
            <div class="ls-lbl">Yaklaşan</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="ftabs-wrap">
  <div class="wrap">
    <div class="ftabs">
      <button class="ftab active" data-f="all">Tüm Maçlar</button>
      <button class="ftab" data-f="live">
        <span class="live-dot"></span>Canlı<span class="bcnt">@Model.LiveCount</span>
      </button>
      <button class="ftab" data-f="finished">Tamamlananlar</button>
      <button class="ftab" data-f="upcoming">Yaklaşanlar</button>
    </div>
  </div>
</div>

<main>
<div class="wrap" style="padding-top:28px;padding-bottom:56px">

@if (featured != null)
{
  <div class="feat-wrap" id="featWrap">
    <div class="feat-lbl">Öne Çıkan Maç</div>

    <a href="/Match/Detail/@featured.MatchId" class="feat-card">
      <div class="row align-items-center g-2">
        <div class="col-5">
          <div class="ft-team">
            <div class="ft-logo">
              @if (!string.IsNullOrWhiteSpace(featured.HomeTeamLogoUrl))
              {
                <img src="@featured.HomeTeamLogoUrl" alt="@featured.HomeTeamShortName"/>
              }
              else
              {
                @featured.HomeTeamShortName
              }
            </div>
            <div class="ft-name">@featured.HomeTeamName</div>
            <div class="ft-type">Ev Sahibi</div>
          </div>
        </div>

        <div class="col-2 text-center">
          <div class="ft-sc-area">
            <div class="ft-sc">
              @if (featured.Status == 1 || featured.Status == 2)
              {
                @($"{featured.HomeScore}–{featured.AwayScore}")
              }
              else
              {
                @("VS")
              }
            </div>

            <div class="ft-stat">
              @if (featured.Status == 1)
              {
                <span style="color:var(--live)">
                  <i class="bi bi-broadcast"></i> CANLI
                </span>
              }
              else if (featured.Status == 2)
              {
                <span>
                  <i class="bi bi-check2-circle"></i> MAÇ BİTTİ
                </span>
              }
              else
              {
                <span style="color:var(--blue)">
                  <i class="bi bi-calendar-event"></i> OYNANMADI
                </span>
              }
            </div>

            <div class="ft-meta">
              @featured.MatchTime
            </div>
          </div>
        </div>

        <div class="col-5">
          <div class="ft-team">
            <div class="ft-logo">
              @if (!string.IsNullOrWhiteSpace(featured.AwayTeamLogoUrl))
              {
                <img src="@featured.AwayTeamLogoUrl" alt="@featured.AwayTeamShortName"/>
              }
              else
              {
                @featured.AwayTeamShortName
              }
            </div>
            <div class="ft-name">@featured.AwayTeamName</div>
            <div class="ft-type">Deplasman</div>
          </div>
        </div>
      </div>

      <div class="text-center mt-3" style="font-size:12px;color:var(--t2)">
        <i class="bi bi-geo-alt"></i> @featured.StadiumName
        &nbsp;·&nbsp;
        <i class="bi bi-calendar3"></i> @featured.MatchDate.ToString("dd MMMM yyyy")
        &nbsp;·&nbsp;
        <span style="color:var(--blue)">Detayları Gör →</span>
      </div>
    </a>
  </div>
}

@if (!Model.Matches.Any())
{
  <div class="empty-box">
    <i class="bi bi-info-circle me-1"></i>
    Bu hafta için maç verisi bulunamadı.
  </div>
}
else
{
  <div class="sec-ttl mcw-section" data-s="live">🔴 &nbsp;Canlı Maçlar</div>

  @foreach (var item in liveMatches)
  {
    var homeWin = item.HomeScore > item.AwayScore;
    var awayWin = item.AwayScore > item.HomeScore;

    <div class="mc-wrap mcw" data-s="live">
      <div class="mc live lp">
        <div class="mc-time">
          <div class="mc-min lc">@item.MatchTime</div>
          <div class="sbadge sb-live"><span class="live-dot"></span>CANLI</div>
        </div>

        <div class="dvv"></div>

        <div class="mc-teams">
          <div class="mc-tr">
            <div class="tl-sm">
              @if (!string.IsNullOrWhiteSpace(item.HomeTeamLogoUrl))
              {
                <img src="@item.HomeTeamLogoUrl" alt="@item.HomeTeamShortName"/>
              }
              else
              {
                @item.HomeTeamShortName
              }
            </div>
            <span class="tn">@item.HomeTeamName</span>
            <span class="ts @(homeWin ? "win" : "")">@item.HomeScore</span>
          </div>

          <div class="mc-tr">
            <div class="tl-sm">
              @if (!string.IsNullOrWhiteSpace(item.AwayTeamLogoUrl))
              {
                <img src="@item.AwayTeamLogoUrl" alt="@item.AwayTeamShortName"/>
              }
              else
              {
                @item.AwayTeamShortName
              }
            </div>
            <span class="tn">@item.AwayTeamName</span>
            <span class="ts @(awayWin ? "win" : "")">@item.AwayScore</span>
          </div>
        </div>

        <a href="/Match/Detail/@item.MatchId" class="det-btn">
          <i class="bi bi-chevron-right"></i>
          <span>Detay</span>
        </a>
      </div>
    </div>
  }

  <div class="sec-ttl mcw-section" data-s="finished" style="margin-top:22px">✅ &nbsp;Tamamlanan Maçlar</div>

  @foreach (var item in finishedMatches)
  {
    var homeWin = item.HomeScore > item.AwayScore;
    var awayWin = item.AwayScore > item.HomeScore;

    <div class="mc-wrap mcw" data-s="finished">
      <div class="mc">
        <div class="mc-time">
          <div class="mc-min">@item.MatchTime</div>
          <div class="sbadge sb-fin">MS</div>
        </div>

        <div class="dvv"></div>

        <div class="mc-teams">
          <div class="mc-tr">
            <div class="tl-sm">
              @if (!string.IsNullOrWhiteSpace(item.HomeTeamLogoUrl))
              {
                <img src="@item.HomeTeamLogoUrl" alt="@item.HomeTeamShortName"/>
              }
              else
              {
                @item.HomeTeamShortName
              }
            </div>
            <span class="tn">@item.HomeTeamName</span>
            <span class="ts @(homeWin ? "win" : "")">@item.HomeScore</span>
          </div>

          <div class="mc-tr">
            <div class="tl-sm">
              @if (!string.IsNullOrWhiteSpace(item.AwayTeamLogoUrl))
              {
                <img src="@item.AwayTeamLogoUrl" alt="@item.AwayTeamShortName"/>
              }
              else
              {
                @item.AwayTeamShortName
              }
            </div>
            <span class="tn">@item.AwayTeamName</span>
            <span class="ts @(awayWin ? "win" : "")">@item.AwayScore</span>
          </div>
        </div>

        <a href="/Match/Detail/@item.MatchId" class="det-btn">
          <i class="bi bi-chevron-right"></i>
          <span>Detay</span>
        </a>
      </div>
    </div>
  }

  <div class="sec-ttl mcw-section" data-s="upcoming" style="margin-top:22px">🕐 &nbsp;Yaklaşan Maçlar</div>

  @foreach (var item in upcomingMatches)
  {
    <div class="mc-wrap mcw" data-s="upcoming">
      <div class="mc">
        <div class="mc-time">
          <div class="mc-min bc">@item.MatchTime</div>
          <div class="sbadge sb-up">FİKSTÜR</div>
        </div>

        <div class="dvv"></div>

        <div class="mc-teams">
          <div class="mc-tr">
            <div class="tl-sm">
              @if (!string.IsNullOrWhiteSpace(item.HomeTeamLogoUrl))
              {
                <img src="@item.HomeTeamLogoUrl" alt="@item.HomeTeamShortName"/>
              }
              else
              {
                @item.HomeTeamShortName
              }
            </div>
            <span class="tn">@item.HomeTeamName</span>
            <span class="ts dim">—</span>
          </div>

          <div class="mc-tr">
            <div class="tl-sm">
              @if (!string.IsNullOrWhiteSpace(item.AwayTeamLogoUrl))
              {
                <img src="@item.AwayTeamLogoUrl" alt="@item.AwayTeamShortName"/>
              }
              else
              {
                @item.AwayTeamShortName
              }
            </div>
            <span class="tn">@item.AwayTeamName</span>
            <span class="ts dim">—</span>
          </div>
        </div>

        <a href="/Match/Detail/@item.MatchId" class="det-btn">
          <i class="bi bi-calendar-check"></i>
          <span>Fikstür</span>
        </a>
      </div>
    </div>
  }
}

</div>
</main>

<footer class="ft">
  <div class="wrap d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
      <div class="ft-brand">PrLeague<span>X</span></div>
      <div>Premier League yönetim sistemi demo projesi.</div>
    </div>

    <div>© 2026 PrLeagueX · Veriler demo amaçlıdır.</div>
  </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<script>
document.querySelectorAll('.ftab').forEach(tab => {
  tab.addEventListener('click', () => {
    document.querySelectorAll('.ftab').forEach(t => t.classList.remove('active'));
    tab.classList.add('active');

    const f = tab.dataset.f;

    document.querySelectorAll('.mcw').forEach(w => {
      w.style.display = (f === 'all' || w.dataset.s === f) ? 'block' : 'none';
    });

    document.querySelectorAll('.mcw-section').forEach(s => {
      s.style.display = (f === 'all' || s.dataset.s === f) ? 'block' : 'none';
    });

    const feat = document.getElementById('featWrap');
    if (feat) feat.style.display = f === 'all' ? 'block' : 'none';
  });
});
</script>

</body>
</html>