@model PrLeagueX.WebUI.Models.FixturePageViewModel

@{
    Layout = null;

    var groupedFixtures = Model.Fixtures
        .OrderBy(x => x.MatchDate)
        .ThenBy(x => x.MatchTime)
        .GroupBy(x => x.MatchDate.Date)
        .ToList();

    var totalMatchCount = Model.Fixtures.Count;
    var firstMatchDate = Model.Fixtures.OrderBy(x => x.MatchDate).FirstOrDefault()?.MatchDate;
    var previousWeek = Model.SelectedWeek > 1 ? Model.SelectedWeek - 1 : 1;
    var nextWeek = Model.SelectedWeek < Model.TotalWeeks ? Model.SelectedWeek + 1 : Model.TotalWeeks;
}

<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Fikstür — PrLeagueX</title>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"/>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;500;600;700;800;900&family=Barlow:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
<link rel="stylesheet" href="~/css/default-navbar.css"/>
<link rel="stylesheet" href="~/css/Fixture.css"/>
</head>

<body>

@await Component.InvokeAsync("_DefaultNavbarComponentPartial")

<section class="pg-head">
  <div class="wrap">
    <div class="row align-items-center g-4">
      <div class="col-lg-7">
        <div class="pg-badge">
          <i class="bi bi-calendar-event"></i>
          Premier League
        </div>

        <h1 class="pg-title">
          Hafta <span style="color:var(--blue)">@Model.SelectedWeek</span> Fikstürü
        </h1>

        <p class="pg-sub">
          PrLeagueX fikstür ekranı · Sezon ve hafta seçimine göre dinamik listelenir
        </p>

        <div class="week-nav">
          <a class="wn-btn"
             asp-controller="Fixture"
             asp-action="Index"
             asp-route-seasonId="@Model.SelectedSeasonId"
             asp-route-week="@previousWeek">
            <i class="bi bi-chevron-left"></i>
            <span>Hafta @previousWeek</span>
          </a>

          <div class="wn-cur">Hafta @Model.SelectedWeek</div>

          <a class="wn-btn"
             asp-controller="Fixture"
             asp-action="Index"
             asp-route-seasonId="@Model.SelectedSeasonId"
             asp-route-week="@nextWeek">
            <span>Hafta @nextWeek</span>
            <i class="bi bi-chevron-right"></i>
          </a>
        </div>
      </div>

      <div class="col-lg-5">
        <div class="filter-card">
          <form method="get" asp-controller="Fixture" asp-action="Index">
            <div class="row g-3">
              <div class="col-md-7">
                <div class="filter-label">
                  <i class="bi bi-calendar3 me-1"></i>
                  Sezon Seçimi
                </div>
                <select name="seasonId" class="form-select filter-select" onchange="this.form.submit()">
                  @foreach (var season in Model.Seasons)
                  {
                    <option value="@season.SeasonId" selected="@(season.SeasonId == Model.SelectedSeasonId)">
                      @season.SeasonName @(season.IsActive ? " · Aktif" : "")
                    </option>
                  }
                </select>
              </div>

              <div class="col-md-5">
                <div class="filter-label">
                  <i class="bi bi-list-ol me-1"></i>
                  Hafta
                </div>
                <select name="week" class="form-select filter-select" onchange="this.form.submit()">
                  @for (int i = 1; i <= Model.TotalWeeks; i++)
                  {
                    <option value="@i" selected="@(i == Model.SelectedWeek)">Hafta @i</option>
                  }
                </select>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<main>
<div class="wrap">
<div class="content">

  <div class="week-summary">
    <div class="ws-card">
      <div class="ws-num" style="color:var(--blue)">@totalMatchCount</div>
      <div class="ws-lbl">Toplam Maç</div>
    </div>
    <div class="ws-card">
      <div class="ws-num" style="color:var(--gold)">@Model.SelectedWeek</div>
      <div class="ws-lbl">Seçili Hafta</div>
    </div>
    <div class="ws-card">
      <div class="ws-num" style="color:var(--green)">
        @(firstMatchDate.HasValue ? firstMatchDate.Value.ToString("dd MMM") : "-")
      </div>
      <div class="ws-lbl">İlk Maç Tarihi</div>
    </div>
    <div class="ws-card">
      <div class="ws-num" style="color:var(--live)">@Model.SelectedSeasonId</div>
      <div class="ws-lbl">Sezon ID</div>
    </div>
  </div>

  @if (!groupedFixtures.Any())
  {
    <div class="empty-box">
      <i class="bi bi-info-circle me-1"></i>
      Bu sezon ve hafta için fikstür bulunamadı.
    </div>
  }
  else
  {
    foreach (var day in groupedFixtures)
    {
      <div class="day-group">
        <div class="day-header">
          <span class="day-title">@day.Key.ToString("dddd")</span>
          <span class="day-date">@day.Key.ToString("dd MMMM yyyy")</span>
          <div class="day-line"></div>
          <span class="day-badge">@day.Count() Maç</span>
        </div>

        @foreach (var item in day)
        {
          var statusText = item.Status switch
          {
            0 => "Oynanmadı",
            1 => "Canlı",
            2 => "Bitti",
            _ => "Bilinmiyor"
          };

          var statusClass = item.Status switch
          {
            0 => "waiting",
            1 => "live",
            2 => "finished",
            _ => ""
          };

          <div class="fx-card">
            <div class="fx-inner">
              <div class="fx-time-col">
                <div class="fx-time">@item.MatchTime</div>
                <div class="fx-status @statusClass">@statusText</div>
              </div>

              <div class="fx-divider"></div>

              <div class="fx-teams">
                <div class="fx-team-home">
                  <span class="fx-name home">@item.HomeTeamName</span>
                  <div class="fx-logo">
                    @if (!string.IsNullOrWhiteSpace(item.HomeTeamLogoUrl))
                    {
                      <img src="@item.HomeTeamLogoUrl" alt="@item.HomeTeamShortName"/>
                    }
                    else
                    {
                      @item.HomeTeamShortName
                    }
                  </div>
                </div>

                <div class="vs-block">
                  @if (item.Status == 2)
                  {
                    <span class="score-box">@item.HomeScore - @item.AwayScore</span>
                  }
                  else
                  {
                    <span class="vs-text">VS</span>
                  }
                </div>

                <div class="fx-team-away">
                  <div class="fx-logo">
                    @if (!string.IsNullOrWhiteSpace(item.AwayTeamLogoUrl))
                    {
                      <img src="@item.AwayTeamLogoUrl" alt="@item.AwayTeamShortName"/>
                    }
                    else
                    {
                      @item.AwayTeamShortName
                    }
                  </div>
                  <span class="fx-name">@item.AwayTeamName</span>
                </div>
              </div>

              <div class="fx-right">
                <span class="fx-stadium">
                  <i class="bi bi-geo-alt" style="font-size:10px;margin-right:3px"></i>
                  @item.StadiumName
                </span>

                <a href="/Match/Detail/@item.MatchId" class="detail-btn">
                  <i class="bi bi-eye"></i>
                  <span>Detay</span>
                </a>
              </div>
            </div>
          </div>
        }
      </div>
    }
  }

</div>
</div>
</main>

@await Component.InvokeAsync("_DefaultFooterComponentPartial")

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>